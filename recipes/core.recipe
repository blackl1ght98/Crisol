# Recetas base de Crisol.
# Formato: clave = valor. Las listas van separadas por comas. '#' comenta.
# Un match_log_any se cumple si aparece CUALQUIERA de sus valores (ignore case).
# Un match_log_contains se cumple solo si aparece ese valor exacto.
# Todas las claves de match se combinan con AND.

[missing-vcrun2022]
confidence = 0.95
priority = 20
match_log_any = msvcp140.dll, vcruntime140.dll, msvcr120.dll, api-ms-win-crt-runtime-l1-1-0.dll, concrt140.dll
action_winetricks = vcrun2022
action_message = Instalando Visual C++ 2022 (vcrun2022)...
action_retry = true

